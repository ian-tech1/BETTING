# Copy to .env locally or add values through Manus/Replit Secrets. Never commit real credentials.
# Local preview uses ephemeral PGLite; production without a hosted URL has no durable log.

# --- Central persistence (Postgres-compatible; required for durable server storage) ---
# Use this explicit variable on Manus because its managed DATABASE_URL is MySQL-compatible.
APP_POSTGRES_URL=
# Use the Supabase transaction-pooler connection string for serverless runtime.
SUPABASE_DATABASE_URL=      # Supabase Dashboard > Project Settings > Database > Connection string
# Optional migration-only URL; prefer a direct or session-pooler connection, not transaction mode.
SUPABASE_MIGRATION_URL=     # used by npm run db:migrate; falls back to APP_POSTGRES_URL/SUPABASE_DATABASE_URL
# Existing Vercel/Neon names remain supported if Supabase is not selected.
POSTGRES_URL=
DATABASE_URL=

# --- Optional AI analyst ---
GEMINI_API_KEY=             # https://aistudio.google.com/apikey; bounded optional analysis nudge
GEMINI_MODEL=               # optional; defaults to gemini-2.5-flash

# --- Optional football data ---
API_FOOTBALL_KEY=           # https://www.api-football.com; fixture results, standings, injuries, lineups
# Optional exact names-to-API-Football league IDs if league search is ambiguous.
API_FOOTBALL_LEAGUE_MAP=    # JSON object, e.g. {"Premier League":39,"La Liga":140}
FOOTBALL_DATA_KEY=          # https://www.football-data.org/client/register; settles logged results

# --- Optional market data ---
ODDS_API_KEY=               # https://the-odds-api.com; current multi-book 1X2 prices and app-observed movement

# --- Optional matchday weather ---
# Coordinates must be verified stadium WGS84 coordinates, keyed by internal match ID or exact venue label.
VENUE_COORDINATES_JSON=     # JSON object, e.g. {"ars-hul":{"latitude":51.5549,"longitude":-0.1084}}
# The public Open-Meteo endpoint is non-commercial only. Set this to your licensed endpoint for commercial use.
OPEN_METEO_BASE_URL=        # default: https://api.open-meteo.com/v1/forecast

# --- Manus AI ---
MANUS_API_URL=
MANUS_API_KEY=
MANUS_PREDICTION_MODEL=

# --- App authentication and admin roles ---
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
ADMIN_USER_IDS=
BOOTSTRAP_ADMIN_USER_ID=

# --- Authorized bookmaker feeds only ---
BETIKA_ODDS_API_URL=
BETIKA_ODDS_API_KEY=
SPORTPESA_ODDS_API_URL=
SPORTPESA_ODDS_API_KEY=
ONE_X_BET_ODDS_API_URL=
ONE_X_BET_ODDS_API_KEY=
# Common aliases are also accepted: BETIKA_API_KEY, SPORTPESA_API_KEY, XBET_API_KEY.

# Never put provider keys under VITE_* variables: those are exposed to browsers.
